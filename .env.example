# Spark — environment variables
# Copy to .env:  cp .env.example .env
# Nothing here is committed. Demo mode still works with every value empty.

# ─── Public deployment ────────────────────────────────────────────────────────
# Domain that Caddy serves. Point an A record at the VM first.
# For a local docker test you can leave this as localhost.
SPARK_DOMAIN=spark.example.com

# Used in OAuth callbacks and in the companion pairing response.
SPARK_PUBLIC_BASE_URL=https://spark.example.com
SPARK_BACKEND_URL=https://spark.example.com

# ─── Security ─────────────────────────────────────────────────────────────────
# REQUIRED on a public URL. Generate with:  openssl rand -hex 32
# Paste the same value into Spark → Settings → Access, and into the
# Chrome extension's settings.
SPARK_OWNER_TOKEN=

# Optional fixed token for a companion you cannot pair interactively.
# Pairing from Settings is preferred; leave this empty unless you need it.
SPARK_COMPANION_TOKEN=

# Optional extra browser origins for local Vite or a loaded extension:
# SPARK_ALLOWED_ORIGINS=http://localhost:5173,chrome-extension://<extension-id>

# ─── Google OAuth ─────────────────────────────────────────────────────────────
# Enable Gmail, Google Calendar and Google Drive APIs in Google Cloud Console,
# then create a Web application OAuth client with this exact redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://spark.example.com/api/auth/google/callback

# ─── AI (free tier) ───────────────────────────────────────────────────────────
# Gemini Flash is the primary planner when set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq is the fallback planner and powers free Whisper speech-to-text.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3

# ─── Voice ────────────────────────────────────────────────────────────────────
# Free Microsoft Edge neural voices (no API key). Set to 0 to use only the
# browser's built-in voice.
SPARK_EDGE_TTS=1
EDGE_TTS_VOICE_EN=en-IN-NeerjaNeural
EDGE_TTS_VOICE_HI=hi-IN-SwaraNeural

# Optional premium voice; when set, it takes priority over Edge TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# ─── Runtime ──────────────────────────────────────────────────────────────────
SPARK_TIMEZONE=Asia/Kolkata
# The Docker stack runs a dedicated worker, so keep this 0 there.
SPARK_BACKGROUND_SYNC=0
SPARK_SYNC_INTERVAL_MINUTES=10
# How many messages per sync get an AI classification (heuristics cover the rest).
SPARK_LLM_SYNC_BUDGET=20
SPARK_RETENTION_DAYS=180

# Docker sets these itself; uncomment only for a bare-metal run.
# SPARK_DATA_DIR=./data
# SPARK_FRONTEND_DIST=./frontend/dist
# SPARK_DB_PATH=./data/spark.db
# SPARK_GOOGLE_TOKEN_PATH=./data/google_token.json
# SPARK_MOCK_STATE=./data/mock_workspace.json

# Optional legacy Bedrock phrasing (Gemini/Groq are preferred).
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
