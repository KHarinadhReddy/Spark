# Spark — Environment Variables
# Copy to .env and fill in your keys for live mode.
# Demo mode works with no keys at all.

# ─── Google OAuth ──────────────────────────────────────────────
# Calendar.events + Gmail.readonly + Gmail.compose + Drive.readonly
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# ─── AWS Bedrock (Claude) ──────────────────────────────────────
# Used only to phrase grounded answers; planner is deterministic.
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ─── ElevenLabs (Premium Voice) ────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
ELEVENLABS_STT_MODEL=scribe_v1

# ─── Optional Overrides ────────────────────────────────────────
# SPARK_DATA_DIR=./data
# SPARK_FRONTEND_DIST=./frontend/dist
# SPARK_DB_PATH=./data/spark.db
# SPARK_MOCK_STATE=./data/mock_workspace.json
# SPARK_SEED=./backend/app/seed/workspace.json
# SPARK_TIMEZONE=Asia/Kolkata
# SPARK_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# SPARK_BACKEND_URL=http://localhost:8000